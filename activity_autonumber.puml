' ==============================================================================
' БИБЛИОТЕКА АВТОМАТИЧЕСКОЙ НУМЕРАЦИИ ДЛЯ ACTIVITY DIAGRAM (PlantUML)
' ==============================================================================
'
' Дополнительные опциональные переменные, которые можно задать ДО директивы !include:
'   !$AA_NEW_BG = "lightgreen"      ' Цвет заливки для акцентных элементов ($newstep, $new_if, $new_repeat)
'   !$AA_ACTIVITY_BG = "#F9F9F9"   ' Устаревшее (legacy), больше не используется в $newstep
'   !$AA_DIAMOND_BG = "white"      ' Базовый цвет фона для обычных ромбов условий и циклов по умолчанию
'
' Библиотека изменяет только фоновый цвет (BackgroundColor) для новых/акцентных элементов.
' Шрифты, размеры, рамки, стрелки и прочее стилизование наследуются из вашей диаграммы.

!if %not(%variable_exists("$AA_NEW_BG"))
  !$AA_NEW_BG = "lightgreen"
!endif

!if %not(%variable_exists("$AA_ACTIVITY_BG"))
  !$AA_ACTIVITY_BG = "#FEFECE"
!endif

!if %not(%variable_exists("$AA_DIAMOND_BG"))
  !$AA_DIAMOND_BG = "#FEFECE"
!endif


' ==============================================================================
' ГЛОБАЛЬНОЕ СОСТОЯНИЕ НУМЕРАЦИИ
' ==============================================================================
' Переменные отслеживают текущий номер шага, глубину вложенности и индексы ветвлений.

!$num = 1
!$depth = 0

!$branch_1 = 0
!$substep_1 = 0
!$single_1 = 0

!$branch_2 = 0
!$substep_2 = 0
!$single_2 = 0


' ==============================================================================
' ГЕНЕРАЦИЯ НОМЕРОВ ШАГОВ
' ==============================================================================
' Внутренняя функция($_get_num_str). Автоматически вычисляет и формирует префикс 
' нумерации (например, "1. ", "1.2.1. ") в зависимости от текущей глубины вложенности 
' ($depth) и состояния ветвей. Не вызывайте вручную, она используется внутри макросов шагов.

!function $_get_num_str()
  !if ($depth == 0)
    !$res = "" + $num
    !$num = $num + 1
    !return $res + ". "
  !endif

  !if ($depth == 1)
    !$substep_1 = $substep_1 + 1
    !if ($single_1 == 1)
      !return "" + $num + "." + $substep_1 + ". "
    !else
      !return "" + $num + "." + $branch_1 + "." + $substep_1 + ". "
    !endif
  !endif

  !if ($depth == 2)
    !$substep_2 = $substep_2 + 1
    !$prefix1 = ""
    !if ($single_1 == 1)
      !$prefix1 = "" + $num + "." + $substep_1
    !else
      !$prefix1 = "" + $num + "." + $branch_1 + "." + $substep_1
    !endif

    !if ($single_2 == 1)
      !return $prefix1 + "." + $substep_2 + ". "
    !else
      !$b2 = $branch_2

      !if ($b2 == 0)
        !$b2 = 1
      !endif

      !return $prefix1 + "." + $b2 + "." + $substep_2 + ". "
    !endif
  !endif

  !return "" + $num + ". "
!endfunction


' ==============================================================================
' НУМЕРАЦИЯ ЗАГОЛОВКОВ УСЛОВИЙ
' ==============================================================================
' Функция ($if_title). Применяется внутри ромбов if, автоматически подставляя 
' корректный порядковый номер текущего шага-условия в зависимости от уровня вложенности.

!function $if_title($text)
  !if ($depth == 0)
    !return "" + $num + ". " + $text
  !endif

  !if ($depth == 1)
    !$next_sub = $substep_1 + 1
    !if ($single_1 == 1)
      !return "" + $num + "." + $next_sub + ". " + $text
    !else
      !return "" + $num + "." + $branch_1 + "." + $next_sub + ". " + $text
    !endif
  !endif

  !if ($depth == 2)
    !$prefix1 = ""

    !if ($single_1 == 1)
      !$prefix1 = "" + $num + "." + $substep_1
    !else
      !$prefix1 = "" + $num + "." + $branch_1 + "." +$substep_1
    !endif

    !return $prefix1 + ". " + $text
  !endif

  !return "" + $num + ". " + $text
!endfunction


' ==============================================================================
' ПЕРЕКЛЮЧЕНИЕ ФОНА (ЛОКАЛЬНЫЕ СТИЛИ)
' ==============================================================================
' Настройка стилей PlantUML для динамического переключения заливки элементов.
' Переопределяется только BackgroundColor; шрифты, рамки и углы наследуются из диаграммы.

<style>
activityDiagram {
  .aaNewAction {
    BackgroundColor $AA_NEW_BG
  }
}
</style>

!procedure $_diamond_new_bg()
<style>
activityDiagram {
  diamond {
    BackgroundColor $AA_NEW_BG
  }
}
</style>
!endprocedure

!procedure $_diamond_normal_bg()
<style>
activityDiagram {
  diamond {
    BackgroundColor $AA_DIAMOND_BG
  }
}
</style>
!endprocedure


' ==============================================================================
' ДЕЙСТВИЯ (ШАГИ ДИАГРАММЫ)
' ==============================================================================
' $step($text)      — Обычный шаг с автоматической сквозной нумерацией.
' $newstep($text)   — Акцентный шаг (подсвечен цветом $AA_NEW_BG) с нумерацией.

!procedure $step($text)
  :$_get_num_str()$text;
!endprocedure

!procedure $newstep($text)
  :$_get_num_str()$text; <<aaNewAction>>
!endprocedure


' ==============================================================================
' УСЛОВИЯ (IF / ELSE / ENDIF)
' ==============================================================================
' Макросы для построения ветвлений с нумерацией заголовков.
' $if(...)        — Стандартное условие.
' $new_if(...)    — Акцентное условие (окрашивает ромб проверки и слияния в цвет $AA_NEW_BG).
' $else(...)      — Ветка альтернативы (по умолчанию с текстом "Нет").
' $endif()        — Завершение ветвления с автоматическим сбросом уровня вложенности.

!procedure $if($text, $then_text="Да")
  if ($if_title($text)) then ($then_text)
!endprocedure

!procedure $new_if($text, $then_text="Да")
  $_diamond_new_bg()
  if ($if_title($text)) then ($then_text)
  $_diamond_normal_bg()
!endprocedure

!procedure $else($text="Нет")
  else ($text)
!endprocedure

!procedure $endif()
  endif
  $end_if()
!endprocedure


' ==============================================================================
' ЦИКЛЫ (REPEAT / REPEAT WHILE)
' ==============================================================================
' Макросы для организации циклов с поддержкой акцентной заливки.
' $repeat()         — Стандартное открытие цикла.
' $new_repeat()     — Акцентное открытие цикла (окрашивает ромб выхода в цвет $AA_NEW_BG).
' $repeat_while(...) — Условие выхода из цикла (по умолчанию: да/нет).

!procedure $repeat()
  repeat
!endprocedure

!procedure $new_repeat()
  $_diamond_new_bg()
  repeat
  $_diamond_normal_bg()
!endprocedure

!procedure $repeat_while($text, $yes="Да", $no="Нет")
  repeat while ($text) is ($yes) not ($no)
!endprocedure


' ==============================================================================
' УПРАВЛЕНИЕ ВЕТВЛЕНИЕМ И ВЛОЖЕННОСТЬЮ
' ==============================================================================
' Служебные функции инкремента и сброса уровней для корректной многоуровневой нумерации.
' $branch($is_single) — Переключает подветки на текущем уровне ($depth).
' $push_if()          — Переходит на следующий уровень глубины вложенности ($depth = 2) при входе в условие.
' $end_if()           — Возвращает уровень вложенности назад при выходе из условия.

!procedure $branch($is_single=0)
  !if ($depth == 0)
    !$depth = 1
    !$branch_1 = 1
    !$substep_1 = 0
    !$single_1 = $is_single
  !else
    !if ($depth == 1)
      !if ($substep_1 == 0)
        !$branch_1 = 1
        !$single_1 = $is_single
      !else
        !$branch_1 = $branch_1 + 1
        !$substep_1 = 0
        !$single_1 = $is_single
      !endif
    !else
      !if ($depth == 2)
        !if ($substep_2 == 0)
          !$branch_2 = 1
          !$single_2 = $is_single
        !else
          !$branch_2 = $branch_2 + 1
          !$substep_2 = 0
          !$single_2 = $is_single
        !endif
      !endif
    !endif
  !endif
!endprocedure

!procedure $push_if()
  !$substep_1 = $substep_1 + 1
  !$depth = 2
  !$branch_2 = 0
  !$substep_2 = 0
  !$single_2 = 0
!endprocedure

!procedure $end_if()
  !if ($depth == 2)
    !$depth = 1
    !$branch_2 = 0
    !$substep_2 = 0
    !$single_2 = 0
  !else
    !if ($depth == 1)
      !$depth = 0
      !$branch_1 = 0
      !$substep_1 = 0
      !$single_1 = 0
      !$num = $num + 1
    !endif
  !endif
!endprocedure