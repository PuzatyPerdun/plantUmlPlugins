' ==============================================================================
' ACTIVITY AUTONUMBER LIBRARY
' ==============================================================================
'
' Библиотека добавляет автоматическую нумерацию для Activity Diagram PlantUML.
'
' Основная идея:
'   $step("Действие")
'       -> 1. Действие
'
'   $if("Условие?")
'       -> 2. Условие?
'
'   Внутри условия:
'       -> 2.1. Действие
'       -> 2.2. Действие
'
' Вложенность IF определяется автоматически.
'
' ==============================================================================
' ПУБЛИЧНЫЕ КОНСТРУКЦИИ
' ==============================================================================
'
' Обычное действие:
'   $step("Получить данные")
'
' Новое действие, выделенное зелёным:
'   $newstep("Получить новые данные")
'
' Обычное условие:
'   $if("Клиент найден?")
'     $step("Обработать клиента")
'   $else("Нет")
'     $step("Завершить обработку")
'   $endif()
'
' Новое условие:
'   $newif("Клиент найден?")
'
' Repeat:
'   $repeat()
'     $step("Обработать элемент")
'   $repeat_while("Есть ещё элементы?")
'
' Новый repeat:
'   $newrepeat()
'
' While:
'   $while("Есть элементы?")
'     $step("Обработать элемент")
'   $endwhile()
'
' Новый while:
'   $newwhile("Есть новые элементы?")
'
' Пользователю библиотеки НЕ НУЖНО вручную управлять:
'   $num
'   $depth
'   внутренними счётчиками вложенности
'
' Библиотека сама определяет:
' - верхнеуровневое или вложенное условие;
' - текущую глубину вложенности;
' - номер следующего шага;
' - момент возврата к родительскому IF;
' - переход к следующему основному номеру после $endif().
'
' ==============================================================================
' НАСТРОЙКА НАЧАЛЬНОЙ НУМЕРАЦИИ
' ==============================================================================
'
' Настройки задаются ДО подключения библиотеки.
'
' По умолчанию:
'   !include activity_autonumber.puml
' Получится:
'   1.
'   2.
'   3.
'
' Начать с другого основного номера:
'   !$AA_START = 4
'   !include activity_autonumber.puml
' Получится:
'   4.
'   5.
'   6.
'
' Продолжить нумерацию внутри пункта 4:
'   !$AA_PREFIX = "4"
'   !include activity_autonumber.puml
' Получится:
'   4.1.
'   4.2.
'   4.3.
'
' Детализировать пункт 4.1:
'   !$AA_PREFIX = "4.1"
'   !include activity_autonumber.puml
' Получится:
'   4.1.1.
'   4.1.2.
'   4.1.3.
'
' PREFIX и START можно использовать одновременно:
'   !$AA_PREFIX = "4"
'   !$AA_START = 3
'   !include activity_autonumber.puml
' Получится:
'   4.3.
'   4.4.
'   4.5.
'
' Вложенность продолжает работать автоматически.
' Например при !$AA_PREFIX = "4.1":
'   4.1.1. Условие
'     4.1.1.1. Действие
'     4.1.1.2. Вложенное условие
'       4.1.1.2.1. Действие


' ==============================================================================
' НАСТРОЙКИ
' ==============================================================================

' Цвет новых элементов.
' Можно переопределить ДО подключения библиотеки:
'   !$AA_NEW_BG = "#A5D6A7"
'   !include activity_autonumber.puml
!$AA_NEW_BG ?= "lightgreen"

' Обычный фон условий.
' Нужен для возврата обычного цвета после выделения нового условия.
!$AA_DIAMOND_BG ?= "white"

' Фиксированный префикс номера.
' Примеры:
'   ""      -> 1, 2, 3
'   "4"     -> 4.1, 4.2, 4.3
'   "4.1"   -> 4.1.1, 4.1.2, 4.1.3
'   "4.1.2" -> 4.1.2.1, 4.1.2.2, 4.1.2.3
!$AA_PREFIX ?= ""

' Первый изменяемый номер текущей диаграммы.
' По умолчанию 1.
' Например !$AA_START = 4 даст 4, 5, 6...
!$AA_START ?= 1


' ==============================================================================
' СОСТОЯНИЕ НУМЕРАЦИИ
' ==============================================================================

' Текущий верхнеуровневый счётчик.
!$num = $AA_START

' Текущая глубина вложенности IF:
' 0 - вне IF
' 1 - внутри первого IF
' 2 - внутри вложенного IF
' и т.д.
!$depth = 0


' ==============================================================================
' ВНУТРЕННИЕ ФУНКЦИИ
' ==============================================================================
'
' Всё ниже до раздела "ДЕЙСТВИЯ" является внутренней реализацией.
' Пользователю диаграммы эти функции напрямую вызывать не нужно.


' ------------------------------------------------------------------------------
' Формирование имени внутренней переменной
' ------------------------------------------------------------------------------
'
' Для каждого уровня IF хранится собственный счётчик подшагов:
'   $aa_sub_1
'   $aa_sub_2
'   $aa_sub_3
!function $_aa_var($type, $level)
  !return "$aa_" + $type + "_" + $level
!endfunction

' ------------------------------------------------------------------------------
' Формирование текущего корневого номера
' ------------------------------------------------------------------------------
'
' Объединяет фиксированный $AA_PREFIX и изменяемый $num.
'
' Примеры:
'   AA_PREFIX = "",    num = 4 -> 4
'   AA_PREFIX = "4",   num = 1 -> 4.1
'   AA_PREFIX = "4.1", num = 1 -> 4.1.1
!function $_aa_root_num()
  !if ($AA_PREFIX == "")
    !return "" + $num
  !endif
  !return $AA_PREFIX + "." + $num
!endfunction


' ==============================================================================
' СОЗДАНИЕ НОВОГО УРОВНЯ IF
' ==============================================================================
'
' При входе в IF увеличивается глубина и создаётся новый счётчик подшагов.
' Например:
'   5. Условие
'   5.1. Первый шаг
'   5.2. Второй шаг
'   5.2.1. Шаг внутри вложенного IF
!procedure $_aa_push_level()
  !$depth = $depth + 1
  %set_variable_value($_aa_var("sub", $depth), 0)
!endprocedure

' ==============================================================================
' ГЕНЕРАЦИЯ НОМЕРА СЛЕДУЮЩЕГО ЭЛЕМЕНТА
' ==============================================================================
'
' Верхний уровень:
'   1.
'   2.
'
' Внутри IF:
'   3.1.
'   3.2.
'
' При дополнительной вложенности:
'   3.2.1.
'   3.2.2.
'
' При $AA_PREFIX = "4.1":
'   4.1.1.
'   4.1.2.
'   4.1.2.1.
!function $_aa_next_item()

  ' Вне IF используем текущий корневой номер.
  !if ($depth == 0)
    !$result = $_aa_root_num() + ". "
    !$num = $num + 1
    !return $result
  !endif

  ' Увеличиваем номер подшага текущего уровня.
  !$sub_var = $_aa_var("sub", $depth)
  !$sub = %get_variable_value($sub_var) + 1
  %set_variable_value($sub_var, $sub)

  ' Собираем полный номер по всем уровням вложенности.
  !$result = $_aa_root_num()
  !$i = 1
  !while ($i <= $depth)
    !$current_sub = %get_variable_value($_aa_var("sub", $i))
    !$result = $result + "." + $current_sub
    !$i = $i + 1
  !endwhile

  !return $result + ". "
!endfunction


' ==============================================================================
' ДЕЙСТВИЯ
' ==============================================================================

' Обычное действие:
'   $step("Получить данные")
!procedure $step($text)
  :$_aa_next_item()$text;
!endprocedure

' Новое действие с зелёным фоном:
'   $newstep("Получить новые данные")
!procedure $newstep($text)
  :$_aa_next_item()$text; <<#lightgreen>>
!endprocedure


' ==============================================================================
' ВРЕМЕННОЕ ИЗМЕНЕНИЕ ФОНА УСЛОВИЙ
' ==============================================================================
'
' Внутренние процедуры для:
'   $newif()
'   $newrepeat()
'   $newwhile()

!procedure $_diamond_new_bg()
<style>
activityDiagram {
  diamond {
    BackgroundColor $AA_NEW_BG
  }
}
</style>
!endprocedure

!procedure $_diamond_normal_bg()
<style>
activityDiagram {
  diamond {
    BackgroundColor $AA_DIAMOND_BG
  }
}
</style>
!endprocedure


' ==============================================================================
' ВНУТРЕННЕЕ ОТКРЫТИЕ IF
' ==============================================================================
'
' Общая реализация для:
'   $if()
'   $newif()
'
' $text      - текст условия.
' $then_text - подпись положительной ветки, по умолчанию "Да".
' $is_new    - 0 обычное условие, 1 новое зелёное условие.
!procedure $_aa_open_if($text, $then_text, $is_new)

  ' Верхнеуровневый IF получает текущий корневой номер.
  !if ($depth == 0)
    !$title = $_aa_root_num() + ". " + $text

  ' Вложенный IF считается очередным элементом родительского IF.
  !else
    !$title = $_aa_next_item() + $text
  !endif

  ' Создаём новый уровень вложенности.
  $_aa_push_level()

  ' Рисуем новое или обычное условие.
  !if ($is_new == 1)
    $_diamond_new_bg()
    if ($title) then ($then_text)
    $_diamond_normal_bg()
  !else
    if ($title) then ($then_text)
  !endif

!endprocedure


' ==============================================================================
' IF
' ==============================================================================

' Обычное условие:
'
'   $if("Клиент найден?")
'     $step("Обработать клиента")
'   $else()
'     $step("Создать клиента")
'   $endif()
'
' Результат:
'   5. Клиент найден?
'   5.1. Обработать клиента
'   5.2. Создать клиента
!procedure $if($text, $then_text="Да")
  $_aa_open_if($text, $then_text, 0)
!endprocedure

' Аналог $if(), но условие выделяется зелёным.
!procedure $newif($text, $then_text="Да")
  $_aa_open_if($text, $then_text, 1)
!endprocedure

' ==============================================================================
' ELSE
' ==============================================================================
'
' По умолчанию:
'   $else()
'   -> Нет
'
' Можно задать свой текст:
'   $else("Не найден")
'
' ELSE не создаёт отдельный уровень нумерации.
' Например:
'   $if("Условие?")
'     $step("Шаг по Да")
'   $else("Нет")
'     $step("Шаг по Нет")
'   $endif()
'
' Получится:
'   5. Условие?
'   5.1. Шаг по Да
'   5.2. Шаг по Нет
!procedure $else($text="Нет")
  else ($text)
!endprocedure


' ==============================================================================
' ENDIF
' ==============================================================================
'
' Закрывает текущий IF:
'   $endif()
'
' После закрытия вложенного IF возвращаемся к родительскому уровню.
' После закрытия верхнеуровневого IF основной номер увеличивается.
!procedure $endif()
  endif
  !$depth = $depth - 1
  !if ($depth == 0)
    !$num = $num + 1
  !endif
!endprocedure


' ==============================================================================
' REPEAT
' ==============================================================================
'
' Repeat сначала выполняет тело, затем проверяет условие.
'
'   $repeat()
'     $step("Обработать элемент")
'   $repeat_while("Есть ещё элементы?")

!procedure $repeat()
  repeat
!endprocedure

' Новый repeat с зелёным условием.
!procedure $newrepeat()
  $_diamond_new_bg()
  repeat
  $_diamond_normal_bg()
!endprocedure

' Завершение repeat.
'
' По умолчанию:
'   $repeat_while("Есть ещё элементы?")
'
' С собственными подписями:
'   $repeat_while("Обработаны все элементы?", "Нет", "Да")
!procedure $repeat_while($text, $yes="Да", $no="Нет")
  repeat while ($text) is ($yes) not ($no)
!endprocedure


' ==============================================================================
' WHILE
' ==============================================================================
'
' While сначала проверяет условие, затем выполняет тело.
'
'   $while("Есть элементы?")
'     $step("Обработать элемент")
'   $endwhile()

' Обычный while.
!procedure $while($text, $yes="Да")
  while ($text) is ($yes)
!endprocedure

' Новый while с зелёным условием.
!procedure $newwhile($text, $yes="Да")
  $_diamond_new_bg()
  while ($text) is ($yes)
  $_diamond_normal_bg()
!endprocedure

' Завершение while.
'
' По умолчанию:
'   $endwhile()
'   -> Нет
'
' Можно изменить:
'   $endwhile("Завершить")
!procedure $endwhile($no="Нет")
  endwhile ($no)
!endprocedure