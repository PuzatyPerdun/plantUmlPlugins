' ==============================================================================
' ACTIVITY AUTONUMBER LIBRARY
' ==============================================================================
'
' Библиотека добавляет автоматическую нумерацию для Activity Diagram PlantUML.
'
' Основная идея:
'   $step("Действие")
'       -> 1. Действие
'
'   $if("Условие?")
'       -> 2. Условие?
'
'   Внутри условия:
'       -> 2.1. Действие
'       -> 2.2. Действие
'
' Вложенность IF определяется автоматически.
'
' ==============================================================================
' ПУБЛИЧНЫЕ КОНСТРУКЦИИ
' ==============================================================================
'
' Обычное действие:
'   $step("Получить данные")
'
' Новое действие, выделенное зелёным:
'   $newstep("Получить новые данные")
'
' Обычное условие:
'   $if("Клиент найден?")
'     $step("Обработать клиента")
'   $else("Нет")
'     $step("Завершить обработку")
'   $endif()
'
' Новое условие:
'   $newif("Клиент найден?")
'
' IF с отдельной нумерацией веток:
'   $if_branches("Клиент найден?")
'     $step("Проверить клиента")
'     $step("Сохранить клиента")
'   $else()
'     $step("Создать клиента")
'   $endif()
'
' Результат:
'   3. Клиент найден?
'   Да:
'     3.1.1. Проверить клиента
'     3.1.2. Сохранить клиента
'   Нет:
'     3.2.1. Создать клиента
'
' Repeat:
'   $repeat()
'     $step("Обработать элемент")
'   $repeat_while("Есть ещё элементы?")
'
' Новый repeat:
'   $newrepeat()
'
' While:
'   $while("Есть элементы?")
'     $step("Обработать элемент")
'   $endwhile()
'
' Новый while:
'   $newwhile("Есть новые элементы?")
'
' Пользователю библиотеки НЕ НУЖНО вручную управлять:
'   $depth
'   $branch
'   $push_if
'   $end_if
'
' Библиотека сама определяет:
' - верхнеуровневое или вложенное условие;
' - текущую глубину вложенности;
' - номер следующего шага;
' - момент возврата к родительскому IF;
' - переход к следующему основному номеру после $endif().


' ==============================================================================
' НАСТРОЙКИ
' ==============================================================================

' Цвет новых элементов.
' Можно переопределить ДО подключения библиотеки:
'   !$AA_NEW_BG = "#A5D6A7"
'   !include activity_autonumber.puml
!if %not(%variable_exists("$AA_NEW_BG"))
  !$AA_NEW_BG = "lightgreen"
!endif

' Обычный фон условий.
' Нужен для возврата обычного цвета после выделения нового условия.
!if %not(%variable_exists("$AA_DIAMOND_BG"))
  !$AA_DIAMOND_BG = "white"
!endif


' ==============================================================================
' СОСТОЯНИЕ НУМЕРАЦИИ
' ==============================================================================

' Основной номер верхнеуровневых элементов: 1, 2, 3...
!$num = 1

' Текущая глубина вложенности IF:
' 0 - вне IF
' 1 - внутри первого IF
' 2 - внутри вложенного IF
' и т.д.
!$depth = 0


' ==============================================================================
' ВНУТРЕННИЕ ФУНКЦИИ
' ==============================================================================
'
' Всё ниже до раздела "ДЕЙСТВИЯ" является внутренней реализацией.
' Пользователю диаграммы эти функции напрямую вызывать не нужно.


' ------------------------------------------------------------------------------
' Формирование имени внутренней переменной
' ------------------------------------------------------------------------------
'
' Для каждого уровня IF хранится собственное состояние:
'   $aa_mode_1
'   $aa_branch_1
'   $aa_sub_1
'
' Для второго уровня:
'   $aa_mode_2
'   $aa_branch_2
'   $aa_sub_2
!function $_aa_var($type, $level)
  !return "$aa_" + $type + "_" + $level
!endfunction


' ==============================================================================
' СОЗДАНИЕ НОВОГО УРОВНЯ IF
' ==============================================================================
'
' Вызывается автоматически при открытии каждого IF.
'
' mode = 1:
'   5. Условие?
'   5.1. Действие
'   5.2. Действие
'
' mode = 0:
'   5. Условие?
'   ветка 1:
'     5.1.1.
'     5.1.2.
'   ветка 2:
'     5.2.1.
!procedure $_aa_push_level($mode)
  !$depth = $depth + 1
  %set_variable_value($_aa_var("mode", $depth), $mode)
  %set_variable_value($_aa_var("branch", $depth), 1)
  %set_variable_value($_aa_var("sub", $depth), 0)
!endprocedure


' ==============================================================================
' ГЕНЕРАЦИЯ НОМЕРА СЛЕДУЮЩЕГО ЭЛЕМЕНТА
' ==============================================================================
'
' Верхний уровень:
'   1.
'   2.
'
' Внутри IF:
'   3.1.
'   3.2.
'
' Внутри IF с нумерацией по веткам:
'   3.1.1.
'   3.1.2.
'   3.2.1.
'
' Несколько уровней вложенности собираются автоматически.
!function $_aa_next_item()

  ' Вне IF используем обычный основной номер.
  !if ($depth == 0)
    !$result = "" + $num + ". "
    !$num = $num + 1
    !return $result
  !endif

  ' Увеличиваем номер подшага текущего уровня.
  !$sub_var = $_aa_var("sub", $depth)
  !$sub = %get_variable_value($sub_var) + 1
  %set_variable_value($sub_var, $sub)

  ' Собираем полный номер по всем уровням вложенности.
  !$result = "" + $num
  !$i = 1

  !while ($i <= $depth)
    !$mode = %get_variable_value($_aa_var("mode", $i))
    !$current_sub = %get_variable_value($_aa_var("sub", $i))

    ' Обычная нумерация: 5.1, 5.2...
    !if ($mode == 1)
      !$result = $result + "." + $current_sub

    ' Нумерация по веткам: 5.1.1, 5.2.1...
    !else
      !$current_branch = %get_variable_value($_aa_var("branch", $i))
      !$result = $result + "." + $current_branch + "." + $current_sub
    !endif

    !$i = $i + 1
  !endwhile

  !return $result + ". "
!endfunction


' ==============================================================================
' ДЕЙСТВИЯ
' ==============================================================================

' Обычное действие:
'   $step("Получить данные")
!procedure $step($text)
  :$_aa_next_item()$text;
!endprocedure

' Новое действие с зелёным фоном:
'   $newstep("Получить новые данные")
!procedure $newstep($text)
  :$_aa_next_item()$text; <<#lightgreen>>
!endprocedure


' ==============================================================================
' ВРЕМЕННОЕ ИЗМЕНЕНИЕ ФОНА УСЛОВИЙ
' ==============================================================================
'
' Внутренние процедуры для:
'   $newif()
'   $newif_branches()
'   $newrepeat()
'   $newwhile()

!procedure $_diamond_new_bg()
<style>
activityDiagram {
  diamond {
    BackgroundColor $AA_NEW_BG
  }
}
</style>
!endprocedure

!procedure $_diamond_normal_bg()
<style>
activityDiagram {
  diamond {
    BackgroundColor $AA_DIAMOND_BG
  }
}
</style>
!endprocedure


' ==============================================================================
' ВНУТРЕННЕЕ ОТКРЫТИЕ IF
' ==============================================================================
'
' Общая реализация для:
'   $if()
'   $newif()
'   $if_branches()
'   $newif_branches()
'
' $text      - текст условия.
' $then_text - подпись положительной ветки.
' $mode      - 1 обычная нумерация, 0 нумерация по веткам.
' $is_new    - 0 обычное условие, 1 новое зелёное условие.
!procedure $_aa_open_if($text, $then_text, $mode, $is_new)

  ' Верхнеуровневый IF получает текущий основной номер.
  !if ($depth == 0)
    !$title = "" + $num + ". " + $text

  ' Вложенный IF считается очередным элементом родителя.
  !else
    !$title = $_aa_next_item() + $text
  !endif

  ' Создаём контекст нового IF.
  $_aa_push_level($mode)

  ' Рисуем новое или обычное условие.
  !if ($is_new == 1)
    $_diamond_new_bg()
    if ($title) then ($then_text)
    $_diamond_normal_bg()
  !else
    if ($title) then ($then_text)
  !endif

!endprocedure


' ==============================================================================
' IF
' ==============================================================================

' Обычное условие:
'
'   $if("Клиент найден?")
'     $step("Обработать клиента")
'   $else()
'     $step("Создать клиента")
'   $endif()
'
' Результат:
'   5. Клиент найден?
'   5.1. Обработать клиента
'   5.2. Создать клиента
!procedure $if($text, $then_text="Да")
  $_aa_open_if($text, $then_text, 1, 0)
!endprocedure

' Аналог $if(), но условие выделяется зелёным.
!procedure $newif($text, $then_text="Да")
  $_aa_open_if($text, $then_text, 1, 1)
!endprocedure

' ==============================================================================
' ELSE
' ==============================================================================
'
' По умолчанию:
'   $else()
'   -> Нет
'
' Можно задать свой текст:
'   $else("Не найден")
'
' Для $if() нумерация просто продолжается.
' Для $if_branches() автоматически увеличивается номер ветки и
' сбрасывается номер подшага.
!procedure $else($text="Нет")

  !if ($depth > 0)
    !$mode = %get_variable_value($_aa_var("mode", $depth))

    !if ($mode == 0)
      !$branch_var = $_aa_var("branch", $depth)
      !$next_branch = %get_variable_value($branch_var) + 1
      %set_variable_value($branch_var, $next_branch)
      %set_variable_value($_aa_var("sub", $depth), 0)
    !endif
  !endif

  else ($text)

!endprocedure


' ==============================================================================
' ENDIF
' ==============================================================================
'
' Закрывает текущий IF:
'   $endif()
'
' Библиотека сама понимает, закрывается вложенный или верхнеуровневый IF.
'
' После закрытия верхнеуровневого IF основной номер увеличивается:
'
'   5. Условие?
'   ...
'   $endif()
'   $step(...)
'
' Следующий шаг:
'   6.
!procedure $endif()

  endif
  !$depth = $depth - 1

  !if ($depth == 0)
    !$num = $num + 1
  !endif

!endprocedure


' ==============================================================================
' REPEAT
' ==============================================================================
'
' Repeat сначала выполняет тело, затем проверяет условие.
'
'   $repeat()
'     $step("Обработать элемент")
'   $repeat_while("Есть ещё элементы?")

!procedure $repeat()
  repeat
!endprocedure

' Новый repeat с зелёным условием.
!procedure $newrepeat()
  $_diamond_new_bg()
  repeat
  $_diamond_normal_bg()
!endprocedure

' Завершение repeat.
'
' По умолчанию:
'   $repeat_while("Есть ещё элементы?")
'
' С собственными подписями:
'   $repeat_while("Обработаны все элементы?", "Нет", "Да")
!procedure $repeat_while($text, $yes="Да", $no="Нет")
  repeat while ($text) is ($yes) not ($no)
!endprocedure


' ==============================================================================
' WHILE
' ==============================================================================
'
' While сначала проверяет условие, затем выполняет тело.
'
'   $while("Есть элементы?")
'     $step("Обработать элемент")
'   $endwhile()

' Обычный while.
!procedure $while($text, $yes="Да")
  while ($text) is ($yes)
!endprocedure

' Новый while с зелёным условием.
!procedure $newwhile($text, $yes="Да")
  $_diamond_new_bg()
  while ($text) is ($yes)
  $_diamond_normal_bg()
!endprocedure

' Завершение while.
'
' По умолчанию:
'   $endwhile()
'   -> Нет
'
' Можно изменить:
'   $endwhile("Завершить")
!procedure $endwhile($no="Нет")
  endwhile ($no)
!endprocedure